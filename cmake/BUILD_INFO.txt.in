BennuGD64 @BENNUGD_PACKAGE_VERSION@
platform: @BENNUGD_PACKAGE_OS@
arch: @BENNUGD_PACKAGE_ARCH@
linkage: @BENNUGD_PACKAGE_LINKAGE@
