# Xbox 360 homebrew: static interpreter ELF for XeLL/libXenon.

set (STATIC_MODULES ON CACHE BOOL "Xbox 360 homebrew is a single ELF" FORCE)
set (INTERPRETER_ONLY ON CACHE BOOL "Compile .prg files with a host bgdc" FORCE)
set (USE_LIBDES ON CACHE BOOL "Use bundled DES with newlib" FORCE)
set (CMAKE_POSITION_INDEPENDENT_CODE OFF CACHE BOOL "libXenon uses fixed-address ELF" FORCE)

set (SDL_SHARED OFF CACHE BOOL "" FORCE)
set (SDL_STATIC ON CACHE BOOL "" FORCE)
set (SDL_DYNAPI OFF CACHE BOOL "" FORCE)
set (SDL_SYSTEM_ICONV OFF CACHE BOOL "" FORCE)
set (SDL_OPENGL OFF CACHE BOOL "" FORCE)
set (SDL_OPENGLES OFF CACHE BOOL "" FORCE)
set (SDL_VULKAN OFF CACHE BOOL "" FORCE)
set (SDL_RENDER_GPU OFF CACHE BOOL "" FORCE)
set (SDL_GPU OFF CACHE BOOL "" FORCE)
set (SDL_HIDAPI OFF CACHE BOOL "" FORCE)
set (SDL_VIRTUAL_JOYSTICK OFF CACHE BOOL "" FORCE)
set (SDL_CAMERA OFF CACHE BOOL "" FORCE)
set (SDL_HAPTIC OFF CACHE BOOL "" FORCE)
set (SDL_SENSOR OFF CACHE BOOL "" FORCE)
set (SDL_THREADS OFF CACHE BOOL "" FORCE)
set (SDL_PTHREADS OFF CACHE BOOL "" FORCE)
set (SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "" FORCE)
set (HAVE_SDL_TIMERS TRUE CACHE BOOL "" FORCE)
set (HAVE_SIGACTION OFF CACHE BOOL "" FORCE)
set (HAVE_SIGTIMEDWAIT OFF CACHE BOOL "" FORCE)
set (HAVE_SA_SIGACTION OFF CACHE BOOL "" FORCE)
set (HAVE_SIGNAL_H OFF CACHE BOOL "" FORCE)
set (HAVE_SIGNAL_SUPPORT OFF CACHE BOOL "" FORCE)

set (CMAKE_EXECUTABLE_SUFFIX ".elf")
set (CMAKE_EXECUTABLE_SUFFIX_C ".elf")

find_library (XBOX360_XENON_LIBRARY xenon PATHS "${DEVKITXENON}/usr/lib" NO_DEFAULT_PATH REQUIRED)
find_library (XBOX360_FAT_LIBRARY fat PATHS "${DEVKITXENON}/usr/lib" NO_DEFAULT_PATH REQUIRED)

add_library (Xbox360::Xenon STATIC IMPORTED GLOBAL)
set_target_properties (Xbox360::Xenon PROPERTIES IMPORTED_LOCATION "${XBOX360_XENON_LIBRARY}")
add_library (Xbox360::Fat STATIC IMPORTED GLOBAL)
set_target_properties (Xbox360::Fat PROPERTIES IMPORTED_LOCATION "${XBOX360_FAT_LIBRARY}")
