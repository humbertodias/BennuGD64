# Native Linux toolchain (--target linux) and Emscripten web player (--target wasm).
#   docker build --target linux -t bennugd64-linux -f docker/Dockerfile.linux docker/
#   docker build --target wasm --build-arg EMSCRIPTEN_VERSION=6.0.6 \
#     -t bennugd64-wasm -f docker/Dockerfile.linux docker/

FROM ubuntu:22.04 AS linux

ENV DEBIAN_FRONTEND=noninteractive \
    PLATFORM=linux

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        ninja-build \
        pkg-config \
        python3 \
        zip \
        libx11-dev \
        libxext-dev \
        libxrandr-dev \
        libxcursor-dev \
        libxi-dev \
        libxfixes-dev \
        libxss-dev \
        libxtst-dev \
        libgl1-mesa-dev \
        libgles2-mesa-dev \
        libegl1-mesa-dev \
        libasound2-dev \
        libpulse-dev \
        libibus-1.0-dev \
        libudev-dev \
        libdbus-1-dev \
        libwayland-dev \
        libxkbcommon-dev \
        libdrm-dev \
        libgbm-dev \
        libsamplerate0-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

WORKDIR /src
CMD ["bash"]

FROM linux AS wasm

ARG EMSCRIPTEN_VERSION=6.0.6
ENV EMSDK=/opt/emsdk \
    EM_CACHE=/tmp/emscripten-cache \
    PLATFORM=wasm

RUN apt-get update \
    && apt-get install -y --no-install-recommends xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 https://github.com/emscripten-core/emsdk.git /opt/emsdk \
    && /opt/emsdk/emsdk install "${EMSCRIPTEN_VERSION}" \
    && /opt/emsdk/emsdk activate "${EMSCRIPTEN_VERSION}" \
    && chmod -R a+rX /opt/emsdk
