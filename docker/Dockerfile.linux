# Native Linux toolchain.
#   docker build --target linux -t bennugd64-linux -f docker/Dockerfile.linux docker/

FROM ubuntu:22.04 AS linux

ENV DEBIAN_FRONTEND=noninteractive \
    PLATFORM=linux

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        ninja-build \
        pkg-config \
        python3 \
        zip \
        libx11-dev \
        libxext-dev \
        libxrandr-dev \
        libxcursor-dev \
        libxi-dev \
        libxfixes-dev \
        libxss-dev \
        libxtst-dev \
        libgl1-mesa-dev \
        libgles2-mesa-dev \
        libegl1-mesa-dev \
        libasound2-dev \
        libpulse-dev \
        libibus-1.0-dev \
        libudev-dev \
        libdbus-1-dev \
        libwayland-dev \
        libxkbcommon-dev \
        libdrm-dev \
        libgbm-dev \
        libsamplerate0-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

WORKDIR /src
CMD ["bash"]
