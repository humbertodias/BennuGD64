# Native Linux toolchain. Build with:
#   docker build -t bennugd64-linux -f docker/Dockerfile.linux docker/
#   docker run --rm -v "$PWD":/src -w /src bennugd64-linux bash scripts/cmake-build.sh

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PLATFORM=linux

COPY apt-linux.txt /tmp/apt-linux.txt
RUN apt-get update \
    && grep -vE '^\s*(#|$)' /tmp/apt-linux.txt \
        | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

WORKDIR /src
CMD ["bash"]
