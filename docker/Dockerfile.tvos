# osxcross → tvOS arm64. Linux host only.
# Apple’s SDK is not in this repo: the image sparse-checkouts an iPhoneOS.sdk
# (Xcode license: https://www.apple.com/legal/sla/docs/xcode.pdf) and retargets
# TBD stubs at tvOS so ld64 emits a tvOS Mach-O.
#
#   bash scripts/build.sh tvos
#
# SDL3 is FetchContent (Metal). MacOSX SDK is still required to build osxcross.

FROM ubuntu:24.04

ARG MACOSX_SDK=15.5
ARG MACOSX_SDK_SHA256=c15cf0f3f17d714d1aa5a642da8e118db53d79429eb015771ba816aa7c6c1cbd
ARG OSX_VERSION_MIN=11.0
ARG CMAKE_VERSION=3.28.6
ARG IPHONEOS_SDK_NAME=iPhoneOS17.5.sdk
ARG IPHONEOS_SDK_REPO=https://github.com/xybp888/iOS-SDKs.git
ARG IPHONEOS_SDK_REF=1b92ff4a8928f582876e1d388d1381c6a0c59eb9

ENV DEBIAN_FRONTEND=noninteractive \
    PLATFORM=tvos \
    OSXCROSS_ROOT=/opt/osxcross \
    OSX_VERSION_MIN=${OSX_VERSION_MIN} \
    MACOSX_DEPLOYMENT_TARGET=${OSX_VERSION_MIN} \
    CC=clang-18 \
    CXX=clang++-18 \
    PATH=/usr/lib/llvm-18/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang-18 \
        cmake \
        cpio \
        curl \
        g++ \
        git \
        libbz2-dev \
        libssl-dev \
        libxml2-dev \
        liblzma-dev \
        lld-18 \
        llvm-18 \
        make \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        uuid-dev \
        wget \
        xz-utils \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sfn /usr/bin/clang-18 /usr/local/bin/clang \
    && ln -sfn /usr/bin/clang++-18 /usr/local/bin/clang++ \
    && git config --system --add safe.directory '*'

WORKDIR /opt
RUN git clone --depth 1 https://github.com/tpoechtrager/osxcross.git osxcross \
    && mkdir -p /opt/osxcross/tarballs \
    && curl -fsSL -o /opt/osxcross/tarballs/MacOSX${MACOSX_SDK}.sdk.tar.xz \
         "https://github.com/joseluisq/macosx-sdks/releases/download/${MACOSX_SDK}/MacOSX${MACOSX_SDK}.sdk.tar.xz" \
    && echo "${MACOSX_SDK_SHA256}  /opt/osxcross/tarballs/MacOSX${MACOSX_SDK}.sdk.tar.xz" | sha256sum -c - \
    && cd /opt/osxcross \
    && UNATTENDED=1 OSX_VERSION_MIN="${OSX_VERSION_MIN}" \
         CC=clang-18 CXX=clang++-18 ./build.sh \
    && rm -rf /opt/osxcross/build /opt/osxcross/tarballs /opt/osxcross/.git \
    && SDK_DIR="$(echo /opt/osxcross/target/SDK/MacOSX*.sdk | awk '{print $1}')" \
    && test -d "${SDK_DIR}" \
    && ln -sfn "${SDK_DIR}" /opt/osxcross/target/SDK/MacOSX.sdk

ENV SDKROOT=/opt/osxcross/target/SDK/MacOSX.sdk \
    PATH=/opt/osxcross/target/bin:/usr/lib/llvm-18/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ARG CMAKE_VERSION
RUN arch="$(uname -m)" \
    && case "${arch}" in \
         x86_64) carch=x86_64 ;; \
         aarch64|arm64) carch=aarch64 ;; \
         *) echo "unsupported cmake host arch: ${arch}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/cmake.tgz \
         "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-${carch}.tar.gz" \
    && tar -xzf /tmp/cmake.tgz -C /opt \
    && rm /tmp/cmake.tgz \
    && ln -sfn /opt/cmake-${CMAKE_VERSION}-linux-${carch}/bin/* /usr/local/bin/ \
    && cmake --version

COPY scripts/apple/fetch-iphoneos-sdk.sh scripts/apple/iphoneos-to-appletvos-sdk.py scripts/apple/apple-sdk-to-simulator.py /tmp/
RUN chmod +x /tmp/fetch-iphoneos-sdk.sh \
    && IPHONEOS_SDK_NAME="${IPHONEOS_SDK_NAME}" \
       IPHONEOS_SDK_REPO="${IPHONEOS_SDK_REPO}" \
       IPHONEOS_SDK_REF="${IPHONEOS_SDK_REF}" \
       /tmp/fetch-iphoneos-sdk.sh /opt/apple/iPhoneOS.sdk \
    && python3 /tmp/iphoneos-to-appletvos-sdk.py \
         /opt/apple/iPhoneOS.sdk /opt/apple/AppleTVOS.sdk \
    && python3 /tmp/apple-sdk-to-simulator.py \
         /opt/apple/AppleTVOS.sdk /opt/apple/AppleTVSimulator.sdk tvos \
    && rm -rf /opt/apple/iPhoneOS.sdk \
         /tmp/fetch-iphoneos-sdk.sh /tmp/iphoneos-to-appletvos-sdk.py \
         /tmp/apple-sdk-to-simulator.py

ENV APPLETVOS_SDK=/opt/apple/AppleTVOS.sdk \
    APPLETVSIMULATOR_SDK=/opt/apple/AppleTVSimulator.sdk \
    SDKROOT=/opt/apple/AppleTVOS.sdk \
    OSXCROSS_TARGET_DIR=/opt/osxcross/target

WORKDIR /src
CMD ["bash"]
