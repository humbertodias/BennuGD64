# Original Xbox homebrew toolchain (linux/amd64: nxdk host tools are x86_64).
#   docker build --platform linux/amd64 -t bennugd64-xbox \
#     -f docker/Dockerfile.xbox docker/
#   docker run --platform linux/amd64 --rm -v "$PWD":/src -w /src \
#     --entrypoint /bin/sh bennugd64-xbox -c 'eval $($NXDK_DIR/bin/activate -s); cmake --preset xbox-i386'
#
# Based on xboxdev/nxdk. Adds cmake/ninja/zip for BennuGD64 host+cross builds.
# Does not clone this repo or bake Bennu into the image.

FROM --platform=linux/amd64 xboxdev/nxdk:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PLATFORM=xbox \
    NXDK_DIR=/usr/src/nxdk \
    PATH="/usr/src/nxdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

USER root

RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache \
        bash \
        ca-certificates \
        cmake \
        curl \
        git \
        ninja \
        python3 \
        zip; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        cmake \
        curl \
        git \
        ninja-build \
        python3 \
        zip \
      && rm -rf /var/lib/apt/lists/*; \
    else \
      echo "Unsupported base package manager in xboxdev/nxdk" >&2; \
      exit 1; \
    fi \
    && git config --system --add safe.directory '*' \
    && test -n "${NXDK_DIR}" \
    && test -x "${NXDK_DIR}/bin/nxdk-cc" \
    && test -f "${NXDK_DIR}/share/toolchain-nxdk.cmake" \
    && test -x "${NXDK_DIR}/tools/cxbe/cxbe" \
    && test -x "${NXDK_DIR}/tools/extract-xiso/build/extract-xiso"

WORKDIR /src
# Clear the upstream activate wrapper so callers control the shell.
ENTRYPOINT []
CMD ["/bin/sh"]
