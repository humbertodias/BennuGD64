# PlayStation 5 payload search paths.
# An ELF loader can still run bgdi.elf. First match wins
# when the loader does not pass a .dcb argument.

TITLE=BennuGD64
# First match wins when the loader does not pass a .dcb argument.
DCB_USB=/mnt/usb0/bennugd64/main.dcb
DCB_DATA=/data/bennugd64/main.dcb
DCB_HOMEBREW=/user/homebrew/bennugd64/main.dcb
DCB_APP0=/app0/main.dcb
LOG=/data/bennugd64/bgdi.log
